# FDE Assistant — machine config read by the scripts. Lives at ~/.config/fde-assistant/config.env (never in a repo).
# install.sh creates it from this template; edit the values, then re-run install.sh.

# The product repo you work in.
FDE_REPO="$HOME/code/your-app"
# Branch feature work is cut from and PRs target.
FDE_BASE_BRANCH="develop"

# OpenSpec store that holds every ticket artifact (local only; never pushed).
FDE_STORE="fde"
FDE_STORE_PATH="$HOME/fde-specs"

# Search scope for bin/facts.sh (git pathspecs, space-separated).
FDE_SRC_GLOBS="*.swift *.kt *.ts *.tsx *.js *.py *.go *.java *.rb"
FDE_TEST_PATTERN="(^|/)(Tests?|test|__tests__|spec)/"
FDE_EXCLUDE=":!*.build/* :!*/node_modules/* :!*/vendor/* :!*.lock :!*.pbxproj :!*.xcassets/*"

# Commit titles for bin/analogs.sh: ERE that matches ticket-tagged commits, and one capturing the ticket id.
FDE_COMMIT_TAG_RE='^\['
FDE_TICKET_ID_RE='\[([A-Za-z]+-?[0-9]+|[a-z0-9]{7,12})\]'

# Optional QA workbench MCP (record → save test → run test). Leave empty if you don't use one.
FDE_QA_MCP=""                          # MCP server name as registered in Claude Code
FDE_QA_RUN_TOOL="run_tests"            # its tool that executes tests
FDE_QA_TESTS_ARG="tests"               # argument listing test paths (must be non-empty)
FDE_QA_DEVICE_ARG="device_id"          # argument naming the device (must be present)
FDE_QA_CATEGORY_ARG="category"
FDE_QA_NEVER_RUN="live"                # case-insensitive regex of categories/paths the assistant must never run

# Optional external branch reviewer. If set, /review-branch runs it instead of the built-in fde-reviewer agent.
# It must accept: [--base <b>] [--change <id>] [--include-uncommitted] and print the path of a markdown review.
FDE_REVIEW_CMD=""

# GitHub CLI for the product repo's PRs (/pr-feedback). Use a wrapper or an env prefix if your work account is not
# the default gh login, e.g. FDE_GH_CMD="env GH_CONFIG_DIR=$HOME/.config/gh-work gh".
FDE_GH_CMD="gh"

# /fde waiting: dependencies older than this many days get a drafted nudge.
FDE_STALE_DAYS=3

# Skills to make user-invocable-only (space-separated), e.g. a team pipeline you don't want auto-triggered.
FDE_SUPPRESS_SKILLS=""

# 1 = write attribution {commit:"",pr:""} into <FDE_REPO>/.claude/settings.local.json (only if gitignored there).
FDE_NO_AI_ATTRIBUTION=1
